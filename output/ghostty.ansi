font-family = Hack Nerd Font
font-family-bold = Hack Nerd Font
font-family-italic = Hack Nerd Font
font-family-bold-italic = Hack Nerd Font
font-size = 8
font-thicken = true
background = #001a22
cursor-color = #007972
mouse-hide-while-typing = true
background-opacity = 0.85
background-blur = 8
unfocused-split-opacity = 0.6
split-divider-color = #007972
command = /bin/zsh
working-directory = inherit
window-padding-x = 10
window-padding-y = 8
click-repeat-interval = 500
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo,path
custom-shader = ~/.config/ghostty/shaders/cursor_warp_faded.glsl
custom-shader = ~/.config/ghostty/shaders/ripple_cursor_custom.glsl
custom-shader-animation = always
macos-titlebar-style = tabs
macos-option-as-alt = left
auto-update-channel = stable
