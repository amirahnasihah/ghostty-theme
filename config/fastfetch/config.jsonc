{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/ascii.txt",
    "type": "file",
    "padding": {
      "right": 5
    }
  },
  "display": {
    "separator": ": ",
    "color": {
      "keys": "38;2;51;133;158",
      "title": "38;2;153;209;206"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "amirah"
    },
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "wmtheme",
    "cpu",
    "gpu",
    "memory",
    "battery",
    "localip",
    "locale",
    "break",
    {
      "type": "colors",
      "symbol": "block"
    }
  ]
}
