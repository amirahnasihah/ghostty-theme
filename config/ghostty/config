# ── CYBER WAVE (exact Warp colors) ───────────────────
background = #001a22
foreground = #ffffff
cursor-color = #007972

# normal colors
palette = 0=#616161
palette = 1=#ff8272
palette = 2=#b4fa72
palette = 3=#fefdc2
palette = 4=#a5d5fe
palette = 5=#ff8ffd
palette = 6=#d0d1fe
palette = 7=#f1f1f1

# bright colors
palette = 8=#8e8e8e
palette = 9=#ffc4bd
palette = 10=#d6fcb9
palette = 11=#fefdd5
palette = 12=#c1e3fe
palette = 13=#ffb1fe
palette = 14=#e5e6fe
palette = 15=#feffff

# ── OPACITY + BLUR ────────────────────────────────────
background-opacity = 0.85
background-blur = 8

# ── FONT ─────────────────────────────────────────────
font-family = Hack Nerd Font
font-size = 11
font-thicken = true

# ── WINDOW ───────────────────────────────────────────
window-decoration = true
macos-titlebar-style = tabs
window-padding-x = 10
window-padding-y = 8
mouse-hide-while-typing = true

# ── SHELL INTEGRATION ─────────────────────────────────
shell-integration = detect

# ── KEYBOARD ─────────────────────────────────────────
macos-option-as-alt = left
keybind = cmd+t=new_tab

# ── SSH FIX ──────────────────────────────────────────
shell-integration-features = sudo,ssh-env,ssh-terminfo

# ── SPLITS ───────────────────────────────────────────
unfocused-split-opacity = 0.6
split-divider-color = #007972

# ── CURSOR SHADERS ───────────────────────────────────
custom-shader = shaders/cursor_warp_faded.glsl
custom-shader = shaders/ripple_cursor_custom.glsl
custom-shader-animation = always
