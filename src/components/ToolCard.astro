---
// One tool in the "All tools" catalogue: official link, what it does, install, real output.
import Terminal from "./Terminal.astro";

interface Props {
  tool: {
    id: string; name: string; url?: string; desc: string; type: string;
    install: string | null; outputHtml: string | null; section?: string; image?: string;
  };
}

const { tool } = Astro.props;
---

<article class="tool" id={`tool-${tool.id}`} data-search={`${tool.id} ${tool.desc}`.toLowerCase()}>
  <header class="tool-head">
    <span class={`tag ${tool.type === "cask" ? "tag-cask" : "tag-shell"}`}>{tool.type}</span>
    {tool.url
      ? <a class="tool-name" href={tool.url} target="_blank" rel="noopener">{tool.name} ↗</a>
      : <span class="tool-name">{tool.name}</span>}
    {tool.section && <span class="tool-more" onclick={`show('${tool.section}', document.querySelector('.nav-item[data-id="${tool.section}"]'))`}>full setup →</span>}
  </header>
  <p class="tool-desc">{tool.desc}</p>
  {tool.install && <code class="tool-install">{tool.install}</code>}
  {tool.outputHtml && <Terminal id={tool.id} />}
  {!tool.outputHtml && tool.image && (
    <figure class="tool-image">
      <img src={tool.image} alt={`${tool.name} — official preview`} loading="lazy" decoding="async" referrerpolicy="no-referrer">
      <figcaption>Source: <a href={tool.url} target="_blank" rel="noopener">{new URL(tool.url!).hostname}</a> (official site)</figcaption>
    </figure>
  )}
  {!tool.outputHtml && !tool.image && tool.url && (
    <a class="tool-docs" href={tool.url} target="_blank" rel="noopener">GUI app — see screenshots on the official site ↗</a>
  )}
</article>
